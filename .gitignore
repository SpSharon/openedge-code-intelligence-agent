# secrets / env
.env
.env.*

# python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# generated index / cache artifacts (rebuilt by ingest)
index/
*.faiss
.embedding_cache/

# editor noise
.vscode/
.idea/
*.swp

# consumer runs (python -m consumer.run)
*.sqlite

# Claude Code's per-machine settings (written when the project MCP server is approved)
.claude/settings.local.json

# service/pipeline output (python -m service.pipeline evals/results --out runs.csv)
/runs.csv

# deployment (deploy/): Terraform state and local inputs stay on the machine
.terraform/
*.tfstate
*.tfstate.*
crash.log
terraform.tfvars
deploy/*.local.json
